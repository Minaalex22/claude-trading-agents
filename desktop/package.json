{
  "name": "jarvis-trading-desktop",
  "productName": "JARVIS Trading",
  "version": "1.0.0",
  "description": "Desktop app for the JARVIS trading system. Opens your pages in their own window, no browser.",
  "main": "main.js",
  "author": "JARVIS Trading",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.jarvis.trading",
    "productName": "JARVIS Trading",
    "artifactName": "JARVIS-Trading-${os}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "pages.js", "loading.html", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "dmg": { "title": "JARVIS Trading" },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS Trading"
    },
    "linux": { "icon": "build/icon.png", "target": ["AppImage"], "category": "Finance" }
  }
}
