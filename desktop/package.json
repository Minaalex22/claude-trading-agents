{
  "name": "jarvis-trading-desktop",
  "productName": "JARVIS Trading",
  "version": "1.1.1",
  "description": "Desktop app for the JARVIS trading system. Opens your pages in their own window, no browser.",
  "main": "main.js",
  "author": "JARVIS Trading",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.jarvis.trading",
    "productName": "JARVIS Trading",
    "artifactName": "JARVIS-Trading-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "pages.js",
      "atas.js",
      "atas.html",
      "atas-preload.js",
      "loading.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS listens when you press Listen or pinch to wake her.",
        "NSCameraUsageDescription": "JARVIS can watch for your pinch gesture to wake her. The video stays on this computer."
      },
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "JARVIS Trading"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS Trading"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    },
    "afterPack": "scripts/adhoc-sign.js"
  }
}
