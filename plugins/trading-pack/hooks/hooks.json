{
  "description": "Blocks any edit or command that would switch real-money trading on.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/real_money_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
